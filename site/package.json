{
  "name": "@master/icons-site",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare-site": "node --import tsx scripts/prepare.ts",
    "dev": "node scripts/dev.mjs",
    "build": "node ../scripts/check-site-node.mjs && bun run prepare-site && astro build",
    "preview": "astro preview --host 127.0.0.1 --port 4321 --ignore-lock",
    "type-check": "node ../scripts/check-site-node.mjs && bun run prepare-site && astro sync && astro-check --tsconfig tsconfig.json && svelte-check --tsconfig tsconfig.json",
    "i18n:audit": "node --import tsx scripts/i18n.ts audit",
    "check:ui": "master-ui check --strict"
  },
  "dependencies": {
    "@master/css": "2.1.5",
    "@master/css-astro": "2.1.5",
    "@master/css-compiler": "2.1.5",
    "@master/css-language-service": "2.1.5",
    "@master/css-preset": "2.1.5",
    "@master/css-schema": "2.1.5",
    "@master/css-tooling": "2.1.5",
    "@master/icons": "workspace:*",
    "@master/internal-site": "0.2.14",
    "@master/ui": "0.0.10",
    "astro": "7.4.2",
    "svelte": "5.57.2",
    "vite": "8.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "svelte-check": "4.7.7"
  }
}
