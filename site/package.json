{
  "name": "@master/icons-site",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare-site": "node scripts/task.mjs prepare-site",
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/task.mjs build",
    "preview": "astro preview --host 127.0.0.1 --ignore-lock",
