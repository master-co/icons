    "@master/css-astro": "2.1.7",
    "@master/css-compiler": "2.1.7",
    "@master/css-language-service": "2.1.7",
    "@master/css-preset": "2.1.7",
    "@master/css-schema": "2.1.7",
    "@master/css-tooling": "2.1.7",
    "@master/icons": "workspace:*",
    "@master/internal-site": "0.3.1",
    "@master/ui": "0.0.11",
    "astro": "7.4.2",
    "svelte": "5.57.2",
    "vite": "8.3.5",
    "@master/icons-svelte": "workspace:*",
    "@master/icons-astro": "workspace:*"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@astrojs/check": "0.9.12",
    "sirv": "3.0.2",
    "svelte-check": "4.7.7"
  }
