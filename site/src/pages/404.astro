---
import {locales,languageOf} from '@master/internal-site/common/locales.js'
const missing={en:'Page not found',tw:'找不到頁面',ja:'ページが見つかりません',ko:'페이지를 찾을 수 없습니다',cn:'找不到页面'}
import translations from '../../i18n/translations'
---
<!doctype html>
<html lang="en">
 <head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex" /><title>404 · Master Icons</title>
  <link rel="icon" href="/favicon.svg" />
 </head>
 <body>
  <main>
   <h1>404</h1>
   <nav>{locales.map(locale=><p lang={languageOf(locale)}>{missing[locale]} · <a href={`${locale==='en'?'':'/'+locale}/icons`}>{translations[locale]['Browse Master Icons']}</a></p>)}</nav>
  </main>
 </body>
</html>
<style>
 :root{color-scheme:light dark;font-family:system-ui,sans-serif}
 main{max-width:40rem;margin:18vh auto;padding:1.5rem}
 h1{font-size:4rem;line-height:1;margin:0}
 a{color:inherit;text-underline-offset:.2em}
</style>
