---
import '@master/ui/components/code.css'
import '@master/ui/components/tabs.css'
import {Settings} from '@master/icons/data/settings'
import {Calendar} from '@master/icons/data/calendar'
import {Sparkles} from '@master/icons/data/sparkles'
import {Undo} from '@master/icons/data/undo'
import {resolveIcon,strokeRanges,strokeWidths} from '@master/icons/runtime'
import * as Icons from '@master/icons-astro'
import {ArrowRightIcon,CopyIcon,CheckIcon} from '@master/icons-astro'
import {form,grid,ink,dimension,label} from './plotter'
interface Props {prefix:string;copy:Record<string,string>;count:number;categories:number;locale:string}
const {prefix,copy,count,categories,locale}=Astro.props
const t=(key:string)=>copy[key]??key
const number=new Intl.NumberFormat(locale==='tw'?'zh-TW':'en').format(count)

/* Sizes: one icon's three masters at one scale, so the 16 px drawing is as much smaller as it really is. */
const sizeScale=6
const sizeFigure=(()=>{
 let x=40,svg=''
 for(const size of [16,20,24] as const){
  const y=200-size*sizeScale,placement={size,corner:'soft' as const,x,y,scale:sizeScale}
  svg+=grid(placement)+form(Settings,placement,`size-${size}`)+dimension(x,x+size*sizeScale,200,224,`${size}`)
  x+=size*sizeScale+40
 }
 return {svg,width:x}
})()

/*
 * Corners: a detail of the calendar's upper-left corner in each style, magnified and cut to a window, with the arc's
 * center and radius drawn from the rect that carries it.
 */
const cornerFigure=(()=>{
 let svg='<defs>'
 const scale=16,size=24,view=118,window={x:1.75,y:2.75}
 const corners=['sharp','soft','rounded'] as const
 corners.forEach((corner,index)=>{svg+=`<clipPath id="corner-clip-${corner}"><rect x="${20+index*(view+24)}" y="20" width="${view}" height="${view}"/></clipPath>`})
 svg+='</defs>'
 corners.forEach((corner,index)=>{
  const left=20+index*(view+24),top=20
  const x=left-window.x*scale,y=top-window.y*scale
  const body=resolveIcon(Calendar,{size,corner}).nodes[0][1] as {x:number;y:number;rx:number}
  svg+=`<g clip-path="url(#corner-clip-${corner})">${grid({size,corner,x,y,scale})}${form(Calendar,{size,corner,x,y,scale},`corner-${corner}`)}</g>`
  svg+=`<rect class="plot-frame" x="${left}" y="${top}" width="${view}" height="${view}"/>`
  if(body.rx){
   const r=body.rx*scale,cx=x+body.x*scale+r,cy=y+body.y*scale+r
   svg+=`<path class="plot-leader" d="M${cx-5} ${cy}h10M${cx} ${cy-5}v10M${cx} ${cy}L${(cx-r*Math.SQRT1_2).toFixed(2)} ${(cy-r*Math.SQRT1_2).toFixed(2)}"/>`
  }else{
   const cx=x+body.x*scale,cy=y+body.y*scale
   svg+=`<path class="plot-leader" d="M${cx-5} ${cy}h10M${cx} ${cy-5}v10"/>`
  }
  svg+=label(left,top+view+22,t(corner[0].toUpperCase()+corner.slice(1)),'name')
  svg+=label(left+view,top+view+22,`r ${body.rx}`,'value','end')
 })
 return {svg,width:20+corners.length*(view+24)-4}
})()

/* Strokes: one icon in ink at every width the 24 px master takes, over a scale of the widths. */
const strokeFigure=(()=>{
 const widths=strokeWidths.filter(width=>width>=strokeRanges[24][0]&&width<=strokeRanges[24][1])
 const scale=3,step=24*scale+8
 let svg=''
 widths.forEach((width,index)=>{
  const x=20+index*step
  svg+=ink(Sparkles,{size:24,corner:'soft',stroke:width,x,y:16,scale},`stroke-${index}`).replace('<g class="plot-ink"',`<g class="plot-ink" style="--i:${index}"`)
  svg+=`<path class="plot-tick" d="M${x+12*scale} 108v${index===0||index===widths.length-1?10:6}"/>`
  svg+=label(x+12*scale,134,String(width),'value','middle')
 })
 svg+=`<path class="plot-rule" d="M${20+12*scale} 108H${20+(widths.length-1)*step+12*scale}"/>`
 return {svg,width:40+widths.length*step-8}
})()

/* Direction: undo, left to right and mirrored for right-to-left, either side of the axis that reflects it. */
const directionFigure=(()=>{
 const scale=5,size=24,y=24
 let svg=`<path class="plot-centerline" d="M200 12V${y+size*scale+12}"/>`
 svg+=form(Undo,{size,corner:'soft',x:200-28-size*scale,y,scale},'dir-ltr')
 svg+=form(Undo,{size,corner:'soft',x:228,y,scale,direction:'rtl'},'dir-rtl')
 svg+=label(200-28-size*scale/2,y+size*scale+30,'ltr','value','middle')
 svg+=label(228+size*scale/2,y+size*scale+30,'rtl','value','middle')
 return svg
})()

/* The catalog: a sheet of icons at their native 20 px, as a list would show them, each a way into the collection. */
const specimens=['Home','Search','Bell','Calendar','Folder','Camera','Heart','Star','Settings','User','Mail','Lock','Cloud','Clock','Compass','MapPin','Music','Image','Bookmark','Paperclip','Send','Layers','Sparkles','Zap','Sun','Moon','Inbox','Filter','Link','Pencil','Trash','Download']
 .map(name=>({name:name.replace(/(?<=[a-z])(?=[A-Z])/g,'-').toLowerCase(),Icon:(Icons as Record<string,any>)[`${name}Icon`]})).filter(item=>item.Icon)

/*
 * The packages: the same icon at the same setting in each one's own syntax, then its smallest import. Every sample
 * has the same lines, so the sheet keeps its height from tab to tab.
 */
const component=(name:string,usage:string)=>[
 `// ${t('Any size, corner and stroke')}`,
 `import { SearchIcon } from '@master/${name}'`,
 '',
 usage,
 '',
 `// ${t('One master, the smallest import')}`,
 `import { SearchIcon } from '@master/${name}/20/soft'`,
].join('\n')
const jsx='<SearchIcon size={20} corner="rounded" strokeWidth={1.5} />'
const packages=[
 {id:'svg',name:'SVG',package:'@master/icons',code:[
  `// ${t('Any size, corner and stroke')}`,
  `import { Search, renderSvg } from '@master/icons'`,
  '',
  `renderSvg(Search, { size: 20, corner: 'rounded', strokeWidth: 1.5 })`,
  '',
  `// ${t('One master, the smallest import')}`,
  `import search from '@master/icons/svg/20/soft/search.svg'`,
 ].join('\n')},
 {id:'react',name:'React',package:'@master/icons-react',code:component('icons-react',jsx)},
 {id:'vue',name:'Vue',package:'@master/icons-vue',code:component('icons-vue','<SearchIcon :size="20" corner="rounded" :stroke-width="1.5" />')},
 {id:'svelte',name:'Svelte',package:'@master/icons-svelte',code:component('icons-svelte',jsx)},
 {id:'preact',name:'Preact',package:'@master/icons-preact',code:component('icons-preact',jsx)},
 {id:'astro',name:'Astro',package:'@master/icons-astro',code:component('icons-astro',jsx)},
]
const firstPackage='react'
const escape=(text:string)=>text.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
/** Colors a sample: comments, strings, keywords, tags and attribute names, in that order of precedence. */
const paint=(code:string)=>{
 const token=/(\/\/.*$)|('[^']*'|"[^"]*")|\b(import|from)\b|(<\/?[A-Za-z]\w*|\/?>)|([:\w-]+)(?==)/gm
 let html='',last=0
 for(const match of code.matchAll(token)){
  const kind=match[1]?'c':match[2]?'s':match[3]?'k':match[4]?'t':'a'
  html+=escape(code.slice(last,match.index))+`<span class="icons-code-${kind}">${escape(match[0])}</span>`
  last=match.index+match[0].length
 }
 return html+escape(code.slice(last))
}
---

{/*
  What the library is, in six cards: its sizes, corners and strokes drawn as constructions, then its packages, its
  catalog and its manners. Every figure is drawn from the icons' own geometry at build time.
*/}
<section id="features" class="home-section icons-features" aria-labelledby="features-title">
 <div class="app-wrapper home-section-wrap">
  <header class="home-section-header">
   <p class="home-eyebrow"><span class="home-eyebrow-index" aria-hidden="true">02</span><span>{t('The library')}</span></p>
   <h2 id="features-title" class="home-section-heading">{t('Nine drawings behind every icon.')}</h2>
   <p class="home-section-body">{t('Three sizes by three corner styles, and a correction for every stroke. Choose the setting; the drawing that fits it is already made.')}</p>
  </header>

  {/* One tray, as on the Master UI homepage: a caption row, then raised sheets, each a data sheet with its drawing. */}
  <figure class="icons-library home-reveal-item" aria-labelledby="features-title">
   <figcaption class="icons-library-bar">
    <span class="home-annotation">{t('Drawn from the package')}</span>
    <span class="icons-library-status home-annotation"><span class="icons-library-dot" aria-hidden="true"></span><span>{t('Every figure is the icons’ own geometry, rendered when this page was built')}</span></span>
   </figcaption>
   <div class="icons-library-grid">
   <article class="icons-sheet home-reveal-item icons-sheet-sizes">
    <p class="icons-sheet-meta home-annotation"><span>01</span><span>16 · 20 · 24</span></p>
    <h3 class="icons-sheet-title">{t('Three sizes, three drawings')}</h3>
    <p class="icons-sheet-body">{t('16, 20 and 24 px each have a drawing of their own. A small master drops detail instead of shrinking it.')}</p>
    <div class="icons-sheet-figure">
     <svg class="icons-plot" viewBox={`0 0 ${sizeFigure.width} 244`} role="img" aria-label={t('The settings icon drawn at 16, 20 and 24 px on its pixel grid.')} set:html={sizeFigure.svg} />
    </div>
   </article>
   <article class="icons-sheet home-reveal-item icons-sheet-corners">
    <p class="icons-sheet-meta home-annotation"><span>02</span><span>sharp · soft · rounded</span></p>
    <h3 class="icons-sheet-title">{t('Corners change the geometry')}</h3>
    <p class="icons-sheet-body">{t('Sharp, soft and rounded redraw the outline and the room inside it, not only the line joins.')}</p>
    <div class="icons-sheet-figure">
     <svg class="icons-plot" viewBox={`0 0 ${cornerFigure.width} 172`} role="img" aria-label={t('The upper-left corner of the calendar icon with sharp, soft and rounded corners.')} set:html={cornerFigure.svg} />
    </div>
   </article>
   <article class="icons-sheet home-reveal-item icons-sheet-strokes">
    <p class="icons-sheet-meta home-annotation"><span>03</span><span>0.75 – 2.5</span></p>
    <h3 class="icons-sheet-title">{t('Strokes in quarter steps')}</h3>
    <p class="icons-sheet-body">{t('From 0.75 to 2.5 units. Heavier widths take corrected geometry, so small counters stay open.')}</p>
    <div class="icons-sheet-figure">
     <svg class="icons-plot" viewBox={`0 0 ${strokeFigure.width} 142`} role="img" aria-label={t('The sparkles icon at every stroke width from 1.25 to 2.5.')} set:html={strokeFigure.svg} />
    </div>
   </article>
   <article class="icons-sheet home-reveal-item icons-sheet-code">
    <p class="icons-sheet-meta home-annotation"><span>04</span><span>@master/icons-*</span></p>
    <h3 class="icons-sheet-title">{t('One geometry, six packages')}</h3>
    <p class="icons-sheet-body">{t('Plain SVG, React, Vue, Svelte, Preact and Astro. Install only your framework’s adapter; a fixed entry ships one master.')}</p>
    <div class="icons-sheet-code">
     <div class="tabs tabs-sm icons-packages" role="tablist" aria-label={t('Packages')} data-packages>
      {packages.map(item=><button type="button" class="tabs-item" role="tab" id={`package-tab-${item.id}`} aria-selected={item.id===firstPackage?'true':'false'} aria-controls={`package-${item.id}`} tabindex={item.id===firstPackage?0:-1}>{item.name}</button>)}
     </div>
     {packages.map(item=>
      <div class="code-panel icons-package" role="tabpanel" id={`package-${item.id}`} aria-labelledby={`package-tab-${item.id}`} hidden={item.id!==firstPackage}>
       <div class="code-header">
        <span class="code-title">{item.package}</span>
        <button type="button" class="btn btn-quiet btn-square icons-copy" data-copy-code data-copied={t('Copied')} data-failed={t('Copy failed')} aria-label={t(`Copy ${item.name}`)}>
         <span class="icons-copy-glyph" aria-hidden="true"><CopyIcon class="icons-copy-idle" size={16} /><CheckIcon class="icons-copy-done" size={16} strokeWidth={1.75} /></span>
        </button>
       </div>
       <pre class="code-block" tabindex="0"><code set:html={paint(item.code)} /></pre>
      </div>
     )}
     <span class="sr-only" aria-live="polite" data-copy-status></span>
    </div>
   </article>
   <article class="icons-sheet home-reveal-item icons-sheet-catalog">
    <p class="icons-sheet-meta home-annotation"><span>05</span><span>{number} · {categories}</span></p>
    <h3 class="icons-sheet-title">{t('{count} icons in {categories} categories').replace('{count}',number).replace('{categories}',String(categories))}</h3>
    <p class="icons-sheet-body">{t('Interface, editing, media, commerce and more, each reviewed at its native size.')}</p>
    <ul class="icons-specimens" aria-label={t('Representative icons')}>
     {specimens.map(({name,Icon},index)=><li><a class="icons-specimen" style={`--c:${index%8}`} href={`${prefix}/icons?q=${name}`} aria-label={name} title={name}><Icon size={20} /></a></li>)}
    </ul>
    <a class="home-section-link icons-sheet-link" href={`${prefix}/icons`}>{t('All icons')}<ArrowRightIcon size={16} /></a>
   </article>
   <article class="icons-sheet home-reveal-item icons-sheet-direction">
    <p class="icons-sheet-meta home-annotation"><span>06</span><span>ltr · rtl</span></p>
    <h3 class="icons-sheet-title">{t('Accessible and direction-aware')}</h3>
    <p class="icons-sheet-body">{t('Icons stay decorative until labeled. Directional icons mirror for right-to-left layouts; the rest keep their orientation.')}</p>
    <div class="icons-sheet-figure">
     <svg class="icons-plot" viewBox="0 0 400 200" role="img" aria-label={t('The undo icon, left to right and mirrored for right to left.')} set:html={directionFigure} />
    </div>
   </article>
   </div>
  </figure>
  <a class="home-section-link icons-features-link home-reveal-item" href={`${prefix}/guide/optical-sizes`}>{t('Read about sizes and corners')}<ArrowRightIcon size={16} /></a>
 </div>
</section>

<script>
 import {tabs} from '@master/ui/behaviors/tabs.js'
 /** The packages' tablist takes the arrow keys and shows the sample of the selected package. */
 for(const list of document.querySelectorAll<HTMLElement>('[data-packages]'))tabs(list)

 /** A sample's copy button hands its code to the clipboard; a check stands in for a moment and the result is announced. */
 for(const button of document.querySelectorAll<HTMLButtonElement>('[data-copy-code]')){
  const status=button.closest('.icons-sheet-code')?.querySelector<HTMLElement>('[data-copy-status]')
  let timer:ReturnType<typeof setTimeout>|undefined
  button.addEventListener('click',async()=>{
   const text=button.closest('.code-panel')?.querySelector('pre')?.textContent??''
   let outcome:'copied'|'failed'
   try{await navigator.clipboard.writeText(text);outcome='copied'}catch{outcome='failed'}
   button.dataset.status=outcome
   if(status)status.textContent=(outcome==='copied'?button.dataset.copied:button.dataset.failed)??''
   clearTimeout(timer)
   timer=setTimeout(()=>{
    delete button.dataset.status
    if(status)status.textContent=''
   },1800)
  })
 }
</script>
