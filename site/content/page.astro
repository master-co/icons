---
import '@master/internal-site/home/design.css'
import '@master/internal-site/home/home.css'
import '../styles/home.css'
import {readFile} from 'node:fs/promises'
import DocHeader from '@master/internal-site/components/DocHeader.svelte'
import HomeLamp from '@master/internal-site/home/HomeLamp.svelte'
import HomeFooter from '@master/internal-site/home/HomeFooter.svelte'
import HomeHero from '../components/home/HomeHero.astro'
import HomeStyles from '../components/home/HomeStyles.astro'
import HomeFeatures from '../components/home/HomeFeatures.astro'
import HomeClose from '../components/home/HomeClose.astro'
import translations from '../i18n/translations'
const locale=Astro.props.params?.locale??Astro.params.locale??'en'
const copy=translations[locale]??translations.en
const prefix=locale==='en'?'':`/${locale}`
const catalog=JSON.parse(await readFile(new URL('../../packages/icons/dist/catalog.json',import.meta.url),'utf8'))
export const documentStyles=false
export const metadata={title:{absolute:'Master Icons — Optical icons for interfaces'},description:'A softly geometric icon library, refined at 16, 20 and 24 pixels. Each size has its own drawing.'}
export async function generateMetadata({params}:{params:{locale:string}}){const copy=translations[params.locale]??translations.en;return{title:{absolute:copy[metadata.title.absolute]},description:copy[metadata.description]}}
const footerNavGroups=[
 {name:'Library',links:[{name:'Icons',href:'/icons'},{name:'Getting started',href:'/guide/getting-started'},{name:'Sizes and corners',href:'/guide/optical-sizes'},{name:'Accessibility',href:'/guide/accessibility'}]},
 {name:'Frameworks',links:[{name:'SVG',href:'/guide/svg'},{name:'React',href:'/guide/react'},{name:'Vue',href:'/guide/vue'},{name:'Svelte',href:'/guide/svelte'},{name:'Preact',href:'/guide/preact'},{name:'Astro',href:'/guide/astro'}]},
 {name:'Project',links:[{name:'License',href:'/guide/license'},{name:'GitHub',href:'https://github.com/master-co/icons'}]},
]
---
<DocHeader client:load class="home-header" stickable />
<main class="overflow-clip home-page icons-home">
 <HomeHero {locale} {prefix} {copy} count={catalog.iconCount} />
 <HomeStyles {copy} />
 <HomeFeatures {locale} {prefix} {copy} count={catalog.iconCount} categories={catalog.categories.length} />
 <HomeClose {locale} {prefix} {copy} />
 <HomeLamp client:idle={{timeout:500}} />
</main>
<HomeFooter client:idle={{timeout:500}} navGroups={footerNavGroups} wordmark="master icons" />
