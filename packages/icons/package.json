{
  "name": "@master/icons",
  "version": "0.0.0",
  "description": "Framework-neutral Master Icons geometry, SVG renderer and optically sized SVG assets.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://icons.master.co",
  "bugs": "https://github.com/master-co/icons/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/master-co/icons.git",
    "directory": "packages/icons"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist/data",
    "dist/index.js",
    "dist/index.d.ts",
    "dist/runtime.js",
    "dist/runtime.d.ts",
    "dist/presentation.js",
    "dist/presentation.d.ts",
    "dist/catalog.json",
    "icons",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "licenses",
    "skills",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./catalog": "./dist/catalog.json",
    "./svg/*": "./icons/*",
    "./package.json": "./package.json",
    "./presentation": {
      "types": "./dist/presentation.d.ts",
      "import": "./dist/presentation.js"
    },
    "./data/*": {
      "types": "./dist/data/*.d.ts",
      "import": "./dist/data/*.js"
    }
  },
  "scripts": {
    "build": "node scripts/sync-svg.mjs",
    "test": "cd ../.. && node --test packages/icons/tests/*.test.mjs",
    "test:types": "tsc -p tests/tsconfig.json && bun run test:types:native",
    "prepack": "bun run build",
    "test:types:native": "astro-check --root . --tsconfig tests/native/tsconfig.json && node scripts/check-svelte.mjs",
    "test:browser": "node --test tests/framework-browser.mjs",
    "generate": "node scripts/build.mjs --incremental --archive-svg"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "icons",
    "svg",
    "icon",
    "optical-size",
    "master",
    "svg-icons"
  ]
}
