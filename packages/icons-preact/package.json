{
  "name": "@master/icons-preact",
  "version": "0.0.0",
  "description": "Master Icons components for Preact.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://icons.master.co",
  "bugs": "https://github.com/master-co/icons/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/master-co/icons.git",
    "directory": "packages/icons-preact"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "licenses",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./icons/*": {
      "types": "./dist/icons/*.d.ts",
      "import": "./dist/icons/*.js",
      "default": "./dist/icons/*.js"
    },
    "./*": {
      "types": "./dist/*/index.d.ts",
      "import": "./dist/*/index.js",
      "default": "./dist/*/index.js"
    },
    "./16/sharp/*": {
      "types": "./dist/16/sharp/*.d.ts",
      "import": "./dist/16/sharp/*.js",
      "default": "./dist/16/sharp/*.js"
    },
    "./16/soft/*": {
      "types": "./dist/16/soft/*.d.ts",
      "import": "./dist/16/soft/*.js",
      "default": "./dist/16/soft/*.js"
    },
    "./16/rounded/*": {
      "types": "./dist/16/rounded/*.d.ts",
      "import": "./dist/16/rounded/*.js",
      "default": "./dist/16/rounded/*.js"
    },
    "./20/sharp/*": {
      "types": "./dist/20/sharp/*.d.ts",
      "import": "./dist/20/sharp/*.js",
      "default": "./dist/20/sharp/*.js"
    },
    "./20/soft/*": {
      "types": "./dist/20/soft/*.d.ts",
      "import": "./dist/20/soft/*.js",
      "default": "./dist/20/soft/*.js"
    },
    "./20/rounded/*": {
      "types": "./dist/20/rounded/*.d.ts",
      "import": "./dist/20/rounded/*.js",
      "default": "./dist/20/rounded/*.js"
    },
    "./24/sharp/*": {
      "types": "./dist/24/sharp/*.d.ts",
      "import": "./dist/24/sharp/*.js",
      "default": "./dist/24/sharp/*.js"
    },
    "./24/soft/*": {
      "types": "./dist/24/soft/*.d.ts",
      "import": "./dist/24/soft/*.js",
      "default": "./dist/24/soft/*.js"
    },
    "./24/rounded/*": {
      "types": "./dist/24/rounded/*.d.ts",
      "import": "./dist/24/rounded/*.js",
      "default": "./dist/24/rounded/*.js"
    }
  },
  "dependencies": {
    "@master/icons": "workspace:*"
  },
  "peerDependencies": {
    "preact": ">=11 <12"
  },
  "scripts": {
    "build": "node ../../scripts/build-frameworks.mjs preact --incremental",
    "prepack": "bun run build && node ../../scripts/framework-package-exports.mjs add",
    "postpack": "node ../../scripts/framework-package-exports.mjs remove"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "icons",
    "svg",
    "icon",
    "optical-size",
    "master",
    "preact",
    "preact-icons"
  ]
}
