{
  "name": "@master/icons-astro",
  "version": "0.0.0",
  "description": "Master Icons components for Astro.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://icons.master.co",
  "bugs": "https://github.com/master-co/icons/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/master-co/icons.git",
    "directory": "packages/icons-astro"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "licenses",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.ts",
      "default": "./dist/index.ts"
    },
    "./package.json": "./package.json",
    "./icons/*": {
      "types": "./dist/icons/*.astro.d.ts",
      "import": "./dist/icons/*.astro",
      "default": "./dist/icons/*.astro"
    },
    "./*": {
      "types": "./dist/*/index.d.ts",
      "import": "./dist/*/index.ts",
      "default": "./dist/*/index.ts"
    },
    "./16/sharp/*": {
      "types": "./dist/16/sharp/*.astro.d.ts",
      "import": "./dist/16/sharp/*.astro",
      "default": "./dist/16/sharp/*.astro"
    },
    "./16/soft/*": {
      "types": "./dist/16/soft/*.astro.d.ts",
      "import": "./dist/16/soft/*.astro",
      "default": "./dist/16/soft/*.astro"
    },
    "./16/rounded/*": {
      "types": "./dist/16/rounded/*.astro.d.ts",
      "import": "./dist/16/rounded/*.astro",
      "default": "./dist/16/rounded/*.astro"
    },
    "./20/sharp/*": {
      "types": "./dist/20/sharp/*.astro.d.ts",
      "import": "./dist/20/sharp/*.astro",
      "default": "./dist/20/sharp/*.astro"
    },
    "./20/soft/*": {
      "types": "./dist/20/soft/*.astro.d.ts",
      "import": "./dist/20/soft/*.astro",
      "default": "./dist/20/soft/*.astro"
    },
    "./20/rounded/*": {
      "types": "./dist/20/rounded/*.astro.d.ts",
      "import": "./dist/20/rounded/*.astro",
      "default": "./dist/20/rounded/*.astro"
    },
    "./24/sharp/*": {
      "types": "./dist/24/sharp/*.astro.d.ts",
      "import": "./dist/24/sharp/*.astro",
      "default": "./dist/24/sharp/*.astro"
    },
    "./24/soft/*": {
      "types": "./dist/24/soft/*.astro.d.ts",
      "import": "./dist/24/soft/*.astro",
      "default": "./dist/24/soft/*.astro"
    },
    "./24/rounded/*": {
      "types": "./dist/24/rounded/*.astro.d.ts",
      "import": "./dist/24/rounded/*.astro",
      "default": "./dist/24/rounded/*.astro"
    }
  },
  "dependencies": {
    "@master/icons": "workspace:*"
  },
  "peerDependencies": {
    "astro": ">=7 <8"
  },
  "scripts": {
    "build": "node ../../scripts/build-frameworks.mjs astro --incremental",
    "prepack": "bun run build && node ../../scripts/framework-package-exports.mjs add",
    "postpack": "node ../../scripts/framework-package-exports.mjs remove"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "icons",
    "svg",
    "icon",
    "optical-size",
    "master",
    "astro",
    "astro-icons"
  ]
}
