{
  "name": "master-icons-workspace",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "site",
    "preview"
  ],
  "scripts": {
    "dev": "bun run --cwd site dev",
    "dev:review": "node scripts/dev.mjs",
    "build": "bun run build:icons && bun run build:review && bun run build:site",
    "build:icons": "node scripts/build-icons.mjs",
    "build:review": "node scripts/build-review.mjs",
    "build:site": "bun run --cwd site build",
    "validate": "node scripts/validate.mjs",
    "test": "bun run --cwd packages/icons test",
    "test:types": "bun run --cwd packages/icons test:types",
    "type-check": "bun run test:types && bun run --cwd site type-check",
    "test:browser": "playwright test",
    "test:site": "playwright test -c site/playwright.config.ts",
    "check": "bun run build && bun run validate && bun run test && bun run type-check",
    "check:reproducible": "node scripts/check-reproducible.mjs",
    "check:package": "node scripts/check-package.mjs",
    "test:site:dev": "playwright test -c site/playwright.dev.config.ts",
    "test:frameworks:browser": "bun run --cwd packages/icons test:browser",
    "pack:icons": "node scripts/pack-icons.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "pathkit-wasm": "1.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "6.0.3",
    "@master/icons": "workspace:*",
    "tsx": "4.23.13",
    "@types/node": "^24.12.2",
    "@astrojs/check": "0.9.12",
    "@astrojs/compiler-rs": "0.5.3",
    "@astrojs/svelte": "9.1.6",
    "astro": "7.4.2",
    "preact": "11.2.0",
    "preact-render-to-string": "6.8.3",
    "svelte": "5.57.2",
    "svelte-check": "4.7.7",
    "vue": "3.5.45",
    "@master/icons-react": "workspace:*",
    "@master/icons-vue": "workspace:*",
    "@master/icons-svelte": "workspace:*",
    "@master/icons-preact": "workspace:*",
    "@master/icons-astro": "workspace:*"
  }
}
