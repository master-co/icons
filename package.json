{
  "name": "master-icons-workspace",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "site",
    "preview",
    "tests"
  ],
  "scripts": {
    "prepare": "husky",
    "dev": "node scripts/turbo.mjs run dev --filter=@master/icons-site",
    "dev:review": "node scripts/turbo.mjs run dev --filter=@master/icons-review",
    "build": "node scripts/turbo.mjs run build",
    "build:icons": "node scripts/turbo.mjs run build --filter=./packages/*",
    "build:review": "node scripts/turbo.mjs run build --filter=@master/icons-review",
    "build:site": "node scripts/turbo.mjs run build --filter=@master/icons-site",
    "validate": "node scripts/turbo.mjs run verify:assets",
    "test": "node scripts/turbo.mjs run test --filter=@master/icons-tests",
    "test:types": "node scripts/turbo.mjs run test:types --filter=@master/icons-tests",
    "type-check": "node scripts/turbo.mjs run test:types type-check",
    "test:browser": "node scripts/turbo.mjs run verify:review-browser",
    "test:site": "node scripts/turbo.mjs run verify:site-browser",
    "check": "node scripts/turbo.mjs run build test test:types type-check i18n:audit check:ui verify:assets",
    "check:reproducible": "node scripts/check-reproducible.mjs",
    "check:package": "node scripts/check-package.mjs",
    "test:site:dev": "node scripts/turbo.mjs run verify:site-dev",
    "test:site:hmr": "node scripts/turbo.mjs run verify:site-hmr",
    "test:frameworks:browser": "node scripts/turbo.mjs run test:browser --filter=@master/icons-tests",
    "pack:icons": "node scripts/pack-icons.mjs",
    "turbo": "node scripts/turbo.mjs",
    "build:strokes": "node scripts/build-strokes.mjs",
    "verify:assets": "node scripts/validate.mjs",
    "verify:review-browser": "playwright test -c preview/playwright.config.mjs",
    "verify:site-browser": "playwright test -c site/playwright.config.ts",
    "verify:site-dev": "playwright test -c site/playwright.dev.config.ts",
    "verify:site-hmr": "node site/scripts/check-dev-updates.mjs",
    "test:turbo": "node scripts/test-turbo.mjs",
    "check:release": "bun scripts/release-config-check.mjs",
    "commit-check": "aronrepo check --from HEAD~1",
    "build:site:cloudflare-pages": "bash scripts/build-site-hosted.sh"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@astrojs/compiler-rs": "0.5.3",
    "@astrojs/svelte": "9.1.6",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.12.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "aronrepo": "4.0.2",
    "astro": "7.4.2",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "husky": "9.1.7",
    "pathkit-wasm": "1.0.0",
    "preact": "11.2.0",
    "preact-render-to-string": "6.8.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "svelte": "5.57.2",
    "svelte-check": "4.7.7",
    "tsx": "4.23.13",
    "turbo": "2.11.11",
    "typescript": "6.0.3",
    "vue": "3.5.45"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/master-co/icons.git"
  },
  "patchedDependencies": {
    "@master/internal-site@0.3.3": "patches/@master%2Finternal-site@0.3.3.patch"
  }
}
